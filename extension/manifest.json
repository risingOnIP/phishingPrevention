{
    "manifest_version": 3,
    "name": "Phishing Prevention",
    "version": "1.0",
    "description": "Flags look-alike phishing pages by recognizing the imitated brand and checking where the site is hosted.",

    "action": {

        "default_title": "Phishing Prevention Chrome Extension",
        "default_popup": "popup.html",
        "default_icon": {              
            "16": "Shield.png",   
            "24": "Shield.png",   
            "32": "Shield.png"    
        }

    },

    "permissions": [
        "tabs", "scripting", "storage"
    ],

    "host_permissions": ["<all_urls>"],

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "background": {
        "service_worker": "worker.js"
    },

    "web_accessible_resources": [
        {
            "resources": ["models/js/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "content_security_policy": {
        "script-src": "self",
        "object-src": "self"
    }


}
