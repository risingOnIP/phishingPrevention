{
    "manifest_version": 3,
    "name": "Phishing Prevention",
    "version": "1.1",
    "description": "Flags look-alike phishing pages by recognizing the imitated brand and checking where the site is hosted.",

    "action": {
        "default_title": "Phishing Prevention",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "Shield.png",
            "24": "Shield.png",
            "32": "Shield.png"
        }
    },

    "permissions": [
        "tabs", "scripting", "storage"
    ],

    "host_permissions": ["<all_urls>"],

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],

    "background": {
        "service_worker": "worker.js"
    },

    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
